// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object T;
}

// Fluid temperature [K]; there is no solid conduction region in this case.
dimensions [0 0 0 1 0 0 0];

// Starting value inside every cell; setFields may replace selected regions.
internalField uniform 300;

boundaryField
{
    // EDIT heated wall absolute temperature [K].
    hotWall
    {
        type fixedValue;
        value uniform 320;
    }

    // EDIT cooled wall absolute temperature [K].
    coldWall
    {
        type fixedValue;
        value uniform 280;
    }

    // Insulated walls: zero normal temperature gradient.
    topAndBottom
    {
        type zeroGradient;
    }

    // 2D direction: must also be empty in the mesh, with one cell through thickness.
    frontAndBack
    {
        type empty;
    }

}
