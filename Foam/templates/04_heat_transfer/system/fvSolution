// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    p_rgh { solver GAMG; tolerance 1e-8; relTol 0.01; smoother DICGaussSeidel; }
    "(U|h)" { solver PBiCGStab; preconditioner DILU; tolerance 1e-8; relTol 0.1; }
}
SIMPLE
{
    momentumPredictor no;
    nNonOrthogonalCorrectors 0;
    // Reference for the pressure-correction nullspace. Absolute pressure/mass
    // comes from 0/p; pRefValue here is not the cavity's atmospheric pressure.
    pRefCell 0;
    pRefValue 0;
    // Tutorial-scale outer targets; tighten for a case-specific accuracy study.
    residualControl { p_rgh 1e-4; U 1e-4; h 1e-4; }
}
relaxationFactors
{
    fields { rho 1; p_rgh 0.7; }
    equations { U 0.3; h 0.3; }
}
