// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}

// EDIT geometry here: coordinates are in metres after multiplication by scale.
scale 1;

// Vertex labels 0..7 form one right-handed hexahedral block.
vertices
(
    (0 0 0) // 0
    (0.584 0 0) // 1
    (0.584 0.584 0) // 2
    (0 0.584 0) // 3
    (0 0 0.01) // 4
    (0.584 0 0.01) // 5
    (0.584 0.584 0.01) // 6
    (0 0.584 0.01) // 7
);

// EDIT (Nx Ny Nz): cell counts; keep empty directions at one cell.
blocks
(
    hex (0 1 2 3 4 5 6 7) (46 46 1) simpleGrading (1 1 1)
);

// Uniform spacing by default; simpleGrading controls expansion ratios.
edges ();

// Patch names must match EVERY field in 0/. Face order points outward.
boundary
(
    walls
    {
        type wall;
        faces ((0 4 7 3) (1 2 6 5) (0 1 5 4));
    }
    atmosphere
    {
        type patch;
        faces ((3 7 6 2));
    }
    frontAndBack
    {
        type empty;
        faces ((0 3 2 1) (4 5 6 7));
    }
);

mergePatchPairs ();
