// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object alpha.water;
}

// Water volume fraction: 0 = air, 1 = water, between 0 and 1 = interface cell.
dimensions [0 0 0 0 0 0 0];

// Starting value inside every cell; setFields may replace selected regions.
internalField uniform 0;

boundaryField
{
    // No prescribed wetting/contact-angle model in this baseline.
    walls
    {
        type zeroGradient;
    }

    // Any incoming fluid is air (alpha.water=0); outward water is allowed.
    atmosphere
    {
        type inletOutlet;
        inletValue uniform 0;
        value uniform 0;
    }

    // 2D direction: must also be empty in the mesh, with one cell through thickness.
    frontAndBack
    {
        type empty;
    }

}
