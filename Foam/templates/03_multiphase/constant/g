// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class uniformDimensionedVectorField;
    object g;
}

// EDIT gravity vector [m/s^2]. Here +y is upward; +z is the thin 2D direction.
dimensions [0 1 -2 0 0 0 0];
value (0 -9.81 0);
