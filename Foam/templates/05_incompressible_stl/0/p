// Kinematic gauge pressure p/rho [m^2/s^2], not absolute pressure in Pa.
FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}
dimensions [0 2 -2 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inlet { type zeroGradient; }
    outlet { type fixedValue; value uniform 0; } // Pressure reference.
    farField { type zeroGradient; }
    "body.*" { type zeroGradient; } // Same body patch pattern as U.
}
