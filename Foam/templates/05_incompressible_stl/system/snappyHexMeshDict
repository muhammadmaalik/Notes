// Active snappyHexMesh settings. This example keeps fluid OUTSIDE a closed body.
// EDIT surface, scale, resolution and fluid seed for your geometry; see this run's README.md.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object snappyHexMeshDict;
}
castellatedMesh true; // Cut/refine the background hex mesh against the surface.
snap true;            // Move boundary vertices onto the triangulated geometry.
addLayers false;      // Start without layers; viscous wall studies need tuned layers.
geometry
{
    part.stl
    {
        type triSurfaceMesh;
        name body; // Used below; creates a body wall patch for a single-region STL.
        // scale 0.001; // Enable ONLY if STL coordinates are in mm; never scale twice.
    }
}
castellatedMeshControls
{
    maxLocalCells 200000;   // Approximate per-processor refinement budget.
    maxGlobalCells 1000000; // Approximate total budget; examine whether refinement finished.
    minRefinementCells 0;
    maxLoadUnbalance 0.1;
    nCellsBetweenLevels 3;
    // Generated by surfaceFeatureExtract from part.stl.
    features ({ file "part.eMesh"; level 2; });
    refinementSurfaces
    {
        body
        {
            level (2 3); // EDIT min/max refinement: each level halves base cell size.
            patchInfo { type wall; }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions {}; // Add geometry-specific wake/gap refinement when needed.
    // EDIT a point INSIDE a fluid cell, away from surfaces and mesh faces.
    // This example point is outside a small body centered at (0 0 0).
    // Internal flow instead requires a seed INSIDE the connected fluid passage.
    locationInMesh (-0.551 0.451 0.351);
    allowFreeStandingZoneFaces true;
}
snapControls
{
    nSmoothPatch 3;
    tolerance 2;
    nSolveIter 30;
    nRelaxIter 5;
    nFeatureSnapIter 10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}
// Dormant while addLayers=false. These are trial settings, not a y+ design.
addLayersControls
{
    relativeSizes true;
    layers { "body.*" { nSurfaceLayers 3; } }
    expansionRatio 1.2;
    finalLayerThickness 0.3;
    minThickness 0.1;
    nGrow 0;
    featureAngle 60;
    slipFeatureAngle 30;
    nRelaxIter 3;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}
meshQualityControls
{
    // Use release-matched OpenCFD quality limits instead of duplicating them.
    #includeEtc "caseDicts/meshQualityDict"
    nSmoothScale 4;
    errorReduction 0.75;
}
writeFlags (scalarLevels);
mergeTolerance 1e-6;
