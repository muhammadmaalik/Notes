// OpenCFD/OpenFOAM independent run. Edit these local inputs using SI units.
// See this run's README.md for settings and usage.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

// Inner linear-solver tolerances; relTol is relative to each solve's initial residual.
solvers
{
    p { solver GAMG; tolerance 1e-8; relTol 0.05; smoother GaussSeidel; }
    U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-8; relTol 0.1; }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1; // Pressure correction for the non-orthogonal snapped mesh.
    // EDIT outer convergence targets. Also inspect mass balance and the solution.
    residualControl { p 1e-6; U 1e-6; }
}
// Smaller factors improve stability at the cost of slower iteration.
relaxationFactors
{
    fields { p 0.3; }
    equations { U 0.7; }
}
