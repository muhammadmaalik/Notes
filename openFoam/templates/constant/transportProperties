// OpenCFD OpenFOAM v2606. Editable input; 
FoamFile
{
	version	2.0;
	format	ascii;
	class	dictionary;
	object	transportProperties;
}

transportModel Newtonian;
//Newtonian tells the openFoam that the fluid has constant visocity.

nu [ 0 2 -1 0 0 0 0] 1e-5;
// This sets the Kinemetic Visocity to 1e-5. Kinemetic viscoity is defined as the ratio between dynamic viscocity and fluid mass denisty -- let's do a quick breakdown of units, viscoity = Pa.s = kg/(m*s), divide that by the density of that fluid = m^2/s .





