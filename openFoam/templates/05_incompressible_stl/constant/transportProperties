// OpenCFD/OpenFOAM independent run. Edit these local inputs using SI units.
// See this run's README.md for settings and usage.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object transportProperties;
}

// Newtonian fluid: nu = dynamic viscosity mu / density rho.
transportModel Newtonian;
// EDIT kinematic viscosity [m^2/s]. Educational laminar default, NOT a measured property of air or water.
// Use Re = speed * body_length / nu to assess the flow regime.
nu [0 2 -1 0 0 0 0] 0.01;
