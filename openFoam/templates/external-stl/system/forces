// OpenCFD OpenFOAM v2606. Editable input; SI units unless noted.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object forces;
}

// Optional: add #include "forces" inside functions {} in controlDict.
forcesOnBody
{
    type forces;
    libs ("libforces.so");
    patches (body);
    p p;
    U U;
    rho rhoInf;
    rhoInf 1.225; // air density [kg/m^3]; change for your fluid
    CofR (0 0 0);
    writeControl timeStep;
    writeInterval 10;
}
