// OpenCFD OpenFOAM v2606. Editable input; SI units unless noted.
FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p;
}

dimensions [0 2 -2 0 0 0 0];
internalField uniform 0;
boundaryField
{
    inlet { type zeroGradient; }
    outlet { type fixedValue; value uniform 0; }
    "(farfield|top|front|back)" { type symmetryPlane; }
    body { type zeroGradient; }
}
