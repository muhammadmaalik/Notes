// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

solvers
{
    // Conservative density, momentum and total-energy explicit updates.
    "(rho|rhoU|rhoE)" { solver diagonal; }
    // Diffusive corrections if nonzero transport is introduced later.
    U { solver smoothSolver; smoother GaussSeidel; nSweeps 2; tolerance 1e-9; relTol 0.01; }
    h { $U; tolerance 1e-10; relTol 0; }
}
