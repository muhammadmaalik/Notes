// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object thermophysicalProperties;
}

// Single ideal gas, constant heat capacity and transport coefficients.
thermoType
{
    type hePsiThermo;
    mixture pureMixture;
    transport const;
    thermo hConst;
    equationOfState perfectGas;
    specie specie;
    energy sensibleInternalEnergy; // rhoCentralFoam evolves internal energy.
}
mixture
{
    specie { molWeight 28.96; } // EDIT molecular weight [kg/kmol]; R = Ru/molWeight.
    thermodynamics
    {
        Cp 1004.5; // EDIT specific heat at constant pressure [J/(kg K)].
        Hf 0;      // Formation enthalpy [J/kg]; energy reference for this nonreacting gas.
    }
    transport
    {
        mu 0; // EDIT dynamic viscosity [Pa s]; zero deliberately models the inviscid benchmark.
        Pr 1; // Dimensionless Prandtl number; irrelevant when mu=0.
    }
}
