// OpenCFD OpenFOAM v2606. Editable input; SI Units
FoamFile
{
	version 2.0;
	format ascii;
	class volVectorField;
	object U;
}

dimensions [0 1 -1 0 0 0 0]
// The order goes like this : Mass(kg) Length(m) Time(s) Temperature(K) Quantity(mole -mol) Current(Amperes A) Luminous Intensity(Candela cd)
internalField uniform (0.01 0 0);
// Sets the initial velocity of every single mesh cell inside our domain to 0.01 m/s in the +x direction. It defines the starting values inside our simulation --everything except the outer fields. And uniform says to apply the same magnitude to every cell without varying length or distance.

boundaryField
{
	inlet { type fixedValue; value uniform (0.01 0 0); }
	outlet { type pressureInletOutletVelocity; value uniform (0.01 0 0); }
	walls { type noSlip; }
}
// For the boundaryField, inlet defines the fluid that is at the boundary of the simulation, and outlet defines the opposite side of the inlet, walls having no slip is defined, this will make the walls to possess friction which will have an influence in the simulation. Typically, we want to define a noSlip condition, as it corresponds to the walls in a real world situation.
