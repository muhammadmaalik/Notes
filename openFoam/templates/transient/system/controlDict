// OpenCFD OpenFOAM v2606. Editable input; SI units unless noted.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object controlDict;
}

application pimpleFoam;
// For a serial restart: change startFrom to latestTime and increase endTime.
startFrom startTime;
startTime 0;
stopAt endTime;
// Steady cases count iterations; transient cases use seconds.
endTime 0.2;
deltaT 0.01;
writeControl adjustableRunTime;
writeInterval 0.05;
purgeWrite 0;
writeFormat ascii;
writePrecision 10;
writeCompression off;
timeFormat general;
timePrecision 8;
runTimeModifiable true;
adjustTimeStep yes;
maxCo 0.5;
maxDeltaT 0.01;
