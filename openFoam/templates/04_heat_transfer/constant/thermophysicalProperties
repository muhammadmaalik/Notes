// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object thermophysicalProperties;
}

// Ideal-gas air: density varies with absolute p and T, producing buoyancy.
thermoType
{
    type heRhoThermo;
    mixture pureMixture;
    transport const;
    thermo hConst;
    equationOfState perfectGas;
    specie specie;
    energy sensibleEnthalpy;
}
mixture
{
    specie { molWeight 28.96; } // EDIT molecular weight [kg/kmol].
    thermodynamics
    {
        Cp 1004.5; // EDIT constant heat capacity [J/(kg K)].
        Hf 0;      // Formation enthalpy reference [J/kg].
    }
    transport
    {
        mu 1.8e-5; // EDIT dynamic viscosity [Pa s], NOT kinematic viscosity.
        Pr 0.71;   // EDIT Prandtl number; thermal conductivity kappa = mu*Cp/Pr.
    }
}
