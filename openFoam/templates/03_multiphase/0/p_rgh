// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p_rgh;
}

// Pressure minus hydrostatic contribution, p_rgh = p - rho*(g dot position) [Pa].
dimensions [1 -1 -2 0 0 0 0];

// Starting value inside every cell; setFields may replace selected regions.
internalField uniform 0;

boundaryField
{
    // Pressure gradient consistent with wall velocity and gravity.
    walls
    {
        type fixedFluxPressure;
        value uniform 0;
    }

    // EDIT atmospheric gauge total pressure [Pa]; 0 is the pressure datum.
    atmosphere
    {
        type totalPressure;
        p0 uniform 0;
        value uniform 0;
    }

    // 2D direction: must also be empty in the mesh, with one cell through thickness.
    frontAndBack
    {
        type empty;
    }

}
