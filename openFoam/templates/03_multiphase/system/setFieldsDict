// OpenCFD/OpenFOAM starter case. Edit a copy in cases/, using SI units.
// See the case README.md and workspace EDITING_GUIDE.md for the editing workflow.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object setFieldsDict;
}

// Start with air, then replace the rectangular column with water.
// EDIT column dimensions AND the mesh bounds when resizing the tank.
defaultFieldValues (volScalarFieldValue alpha.water 0);
regions
(
    boxToCell
    {
        // Slightly outside the mesh in z to cover its complete thickness [m].
        box (-0.001 -0.001 -0.001) (0.146 0.292 0.011);
        fieldValues (volScalarFieldValue alpha.water 1);
    }
);
