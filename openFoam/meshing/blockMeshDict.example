// Copy to a working case as system/blockMeshDict. OpenCFD syntax.
// EXTERNAL FLOW example: box around a small body near the origin, all in metres.
// This is fully 3D. Update every field patch in 0/ to match before solving.
FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    object blockMeshDict;
}
scale 1;
// EDIT domain bounds: upstream, downstream, and side clearance from the body.
vertices
(
    (-1 -1 -1) // 0
    ( 3 -1 -1) // 1
    ( 3  1 -1) // 2
    (-1  1 -1) // 3
    (-1 -1  1) // 4
    ( 3 -1  1) // 5
    ( 3  1  1) // 6
    (-1  1  1) // 7
);
// EDIT base resolution. snappyHexMesh refines near the imported surface.
blocks (hex (0 1 2 3 4 5 6 7) (40 20 20) simpleGrading (1 1 1));
edges ();
boundary
(
    inlet { type patch; faces ((0 4 7 3)); }
    outlet { type patch; faces ((1 2 6 5)); }
    // Outer side patches are NOT solid walls; prescribe suitable far-field BCs.
    farField
    {
        type patch;
        faces ((0 1 5 4) (3 7 6 2) (0 3 2 1) (4 5 6 7));
    }
);
mergePatchPairs ();
